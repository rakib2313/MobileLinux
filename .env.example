# MobileLinux example settings. Safe example values only - NEVER put real secrets in this file.
# Copy to ~/.config/mobilelinux/config.env (preferred, chmod 600) or to <project>/.env (git-ignored).
# Precedence: real environment variables > ~/.config/mobilelinux/config.env > <project>/.env > defaults.
# Easier: use  bash scripts/select-profile.sh  and  bash scripts/setup-vnc.sh resolution  to write these for you.

# Hardware profile: auto | low | mid | high
ML_PROFILE=auto
# proot-distro alias of the guest
ML_DISTRO=debian
# Unprivileged desktop user created inside the guest
ML_USER=mluser
# VNC display number (port = 5900 + number); the server listens on localhost only
ML_VNC_DISPLAY=1
# Optional resolution override, e.g. 1280x720 (empty = use profile default)
# ML_GEOMETRY_OVERRIDE=1280x720
# Set to 1 only to experiment on a non-ARM64 device (unsupported)
# ML_ALLOW_UNSUPPORTED_ARCH=0

# --- Optional AI helper (scripts/ai-assistant.sh) -------------------------------------------
# Put these in ~/.config/mobilelinux/ai.env (chmod 600) or export them. Do not commit real keys.
# AI_API_ENDPOINT=https://api.example.invalid/v1/chat/completions
# AI_MODEL=your-model-name
# AI_API_KEY=replace-me
# AI_API_FORMAT=openai-chat
# AI_MAX_TOKENS=1000
