#!/usr/bin/env bash
# Launches Chromium inside the Debian guest with MobileLinux's conservative flags.
# The sandbox is NOT disabled unless you explicitly opt in:
#   MOBILELINUX_CHROMIUM_NO_SANDBOX=1 mobilelinux-chromium
set -u

CHROMIUM_BIN="$(command -v chromium || command -v chromium-browser || true)"
if [[ -z "$CHROMIUM_BIN" ]]; then
  echo "mobilelinux-chromium: Chromium is not installed (try: bash /opt/MobileLinux/scripts/guest/install-apps.sh --browser chromium)." >&2
  exit 127
fi

flags=()
conf="${XDG_CONFIG_HOME:-$HOME/.config}/mobilelinux/chromium-flags.conf"
[[ -r "$conf" ]] || conf="/etc/mobilelinux/chromium-flags.conf"
if [[ -r "$conf" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line//[[:space:]]/}"
    if [[ -n "$line" ]]; then
      flags+=("$line")
    fi
  done <"$conf"
fi

if [[ "${MOBILELINUX_CHROMIUM_NO_SANDBOX:-0}" == 1 ]]; then
  echo "mobilelinux-chromium: WARNING: running with --no-sandbox. A compromised web page could then" >&2
  echo "mobilelinux-chromium: attack everything this guest user can access. Prefer the Android browser." >&2
  flags+=(--no-sandbox)
fi

exec "$CHROMIUM_BIN" "${flags[@]}" "$@"
